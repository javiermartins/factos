---
const { currentDate } = Astro.props;

const abbreviatedMonths = [
  "Ene",
  "Feb",
  "Mar",
  "Abr",
  "May",
  "Jun",
  "Jul",
  "Ago",
  "Sep",
  "Oct",
  "Nov",
  "Dic",
];

// currentDate llega como YYYY-MM-DD: se parsea a mano para evitar desfases de zona horaria
const [year, month, day] = currentDate.split("-").map(Number);
const formattedDate = `${day} ${abbreviatedMonths[month - 1]}, ${year}`;
---

<>
  {formattedDate}
</>
